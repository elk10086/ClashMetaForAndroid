<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable name="self" type="com.github.kr328.clash.design.MainDesign" />
        <variable name="clashRunning" type="boolean" />
        <variable name="forwarded" type="String" />
        <variable name="mode" type="String" />
        <variable name="profileName" type="String" />
        <variable name="lineName" type="String" />
        <variable name="cloudPlan" type="String" />
        <variable name="cloudExpiry" type="String" />
        <variable name="cloudUsage" type="String" />
        <variable name="cloudProgress" type="int" />
        <variable name="networkResult" type="String" />
        <variable name="uploadSpeed" type="String" />
        <variable name="downloadSpeed" type="String" />
        <variable name="connectionTime" type="String" />
        <import type="com.github.kr328.clash.design.MainDesign.Request" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/windowBackground"
        android:orientation="vertical"
        android:paddingStart="@{self.surface.insets.start}"
        android:paddingEnd="@{self.surface.insets.end}"
        android:paddingTop="@{self.surface.insets.top}">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="@string/cloud_nav_dashboard"
                android:textColor="?attr/colorControlNormal"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:onClick="@{() -> self.request(Request.OpenPlans)}"
                android:paddingHorizontal="8dp"
                android:text="@string/cloud_buy_now"
                android:textColor="?attr/colorControlNormal"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="112dp"
                    android:background="@drawable/cloud_membership_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:defaultFocusHighlightEnabled="true"
                    android:gravity="center_vertical"
                    android:onClick="@{() -> self.request(Request.OpenPlans)}"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@{cloudPlan}"
                        android:textColor="?attr/colorControlNormal"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="1"
                        android:text="@{cloudExpiry}"
                        android:textColor="?attr/colorControlNormal"
                        android:alpha="0.65"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@{cloudUsage}"
                        android:textColor="?attr/colorControlNormal"
                        android:alpha="0.65"
                        android:textSize="13sp" />

                    <ProgressBar
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="8dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="@{cloudProgress}"
                        android:progressTint="?attr/colorPrimary"
                        android:progressBackgroundTint="?attr/colorControlHighlight" />
                </LinearLayout>

                <ImageView
                    android:layout_width="136dp"
                    android:layout_height="136dp"
                    android:layout_marginTop="24dp"
                    android:background="@{clashRunning ? @drawable/cloud_power_active : @drawable/cloud_power_inactive}"
                    android:contentDescription="@string/tap_to_start"
                    android:focusable="true"
                    android:defaultFocusHighlightEnabled="true"
                    android:onClick="@{() -> self.request(Request.ToggleStatus)}"
                    android:padding="44dp"
                    android:src="@{clashRunning ? @drawable/cloud_pause : @drawable/cloud_play}"
                    android:tint="?attr/colorControlNormal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@{connectionTime}"
                    android:textColor="?attr/colorControlNormal"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/cloud_dashboard_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:defaultFocusHighlightEnabled="true"
                        android:gravity="center_vertical"
                        android:onClick="@{() -> self.showModeSelector()}"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cloud_dashboard_mode" android:textColor="?attr/colorControlNormal" android:alpha="0.65" android:textSize="12sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@{mode}" android:textColor="?attr/colorControlNormal" android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>

                    <Space android:layout_width="12dp" android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/cloud_dashboard_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:defaultFocusHighlightEnabled="true"
                        android:gravity="center_vertical"
                        android:onClick="@{() -> self.request(Request.OpenProxy)}"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cloud_nav_lines" android:textColor="?attr/colorControlNormal" android:alpha="0.65" android:textSize="12sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:ellipsize="end" android:maxLines="1" android:text="@{lineName}" android:textColor="?attr/colorControlNormal" android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:weightSum="2">
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/cloud_dashboard_card" android:clickable="true" android:focusable="true" android:defaultFocusHighlightEnabled="true" android:gravity="center_vertical" android:onClick="@{() -> self.request(Request.DetectNetwork)}" android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cloud_dashboard_detection" android:textColor="?attr/colorControlNormal" android:alpha="0.65" android:textSize="12sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:ellipsize="end" android:maxLines="1" android:text="@{networkResult}" android:textColor="?attr/colorControlNormal" android:textSize="15sp" android:textStyle="bold" />
                    </LinearLayout>
                    <Space android:layout_width="12dp" android:layout_height="match_parent" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/cloud_dashboard_card" android:gravity="center_vertical" android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cloud_dashboard_speed" android:textColor="?attr/colorControlNormal" android:alpha="0.65" android:textSize="12sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text='@{"↑ " + uploadSpeed}' android:textColor="?attr/colorControlNormal" android:textSize="13sp" android:textStyle="bold" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text='@{"↓ " + downloadSpeed}' android:textColor="?attr/colorControlNormal" android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

    </LinearLayout>
</layout>
